{
  "name": "supportdesk-mcp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/local-http.ts",
    "inspect:stdio": "npx -y @mcpjam/inspector@latest --port 6275 --tab tools npx tsx \"$PWD/src/stdio.ts\"",
    "inspect:stdio:no-open": "npx -y @mcpjam/inspector@latest --no-open --port 6275 --tab tools npx tsx \"$PWD/src/stdio.ts\"",
    "inspect:http:write": "npx -y @mcpjam/inspector@latest --port 6275 --url http://localhost:8787/mcp --bearer dev-write-token --tab tools",
    "inspect:http:read": "npx -y @mcpjam/inspector@latest --port 6275 --url http://localhost:8787/mcp --bearer dev-read-token --tab tools",
    "test": "vitest run",
    "test:protocol": "vitest run tests/01-protocol-surface.test.ts",
    "test:security": "vitest run tests/02-security-http.test.ts",
    "test:behavior": "vitest run tests/03-behavior-evals.test.ts",
    "test:cross-client": "vitest run tests/04-cross-client-models.test.ts",
    "test:ci": "vitest run tests/01-protocol-surface.test.ts tests/02-security-http.test.ts tests/03-behavior-evals.test.ts tests/04-cross-client-models.test.ts",
    "eval:mock": "vitest run tests/03-behavior-evals.test.ts tests/04-cross-client-models.test.ts",
    "eval:live": "RUN_LIVE_MODEL_EVALS=1 vitest run tests/05-live-model.eval.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "puppeteer": "^25.11.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@mcpjam/sdk": "^8.8.0",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^5.0.1"
  }
}
